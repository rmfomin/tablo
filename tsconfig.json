{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "target": "ES2022",
    "esModuleInterop": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist/js",
    "noEmitOnError": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "types": ["chrome", "node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    },
  },
  "include": ["src"]
}
