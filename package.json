{
  "name": "chrome-extension-typescript-starter",
  "version": "0.92",
  "description": "chrome-extension-typescript-starter",
  "main": "index.js",
  "scripts": {
    "watch": "vite build --watch --mode normal",
    "watch2": "vite build --watch --mode overrideless",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:normal",
    "build:normal": "vite build --mode normal",
    "build:overrideless": "vite build --mode overrideless",
    "publish": "node webpack/publish.js",
    "publish-patch": "node webpack/publish.js --patch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build-style": "npm run build && vitest run src/__tests__/styleBuildConfig.test.ts src/__tests__/styleSelectors.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chibat/chrome-extension-typescript-starter.git"
  },
  "dependencies": {
    "@types/react-transition-group": "^4.4.1",
    "archiver": "^7.0.1",
    "clsx": "1.2.1",
    "fs-extra": "^11.2.0",
    "mixpanel-browser": "^2.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.100",
    "@types/jquery": "^3.3.33",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "happy-dom": "20.10.6",
    "prettier": "^2.2.1",
    "react-switch": "^7.0.0",
    "rimraf": "^3.0.2",
    "sass": "^1.99.0",
    "typescript": "^5.6.3",
    "vite": "8.1.4",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "4.1.10"
  },
  "volta": {
    "node": "24.15.0",
    "npm": "11.12.1"
  }
}
