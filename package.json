{
  "name": "chrome-extension-typescript-starter",
  "version": "0.92",
  "description": "chrome-extension-typescript-starter",
  "main": "index.js",
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "watch2": "webpack --config webpack/webpack.dev.js --watch --env BUILD_TYPE=overrideless",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && webpack --config webpack/webpack.prod.js",
    "publish": "node webpack/publish.js",
    "publish-patch": "node webpack/publish.js --patch",
    "clean": "rimraf dist",
    "test": "npx jest",
    "test:build-style": "npm run build && npx jest src/__tests__/styleBuildConfig.test.ts src/__tests__/styleSelectors.test.ts --runInBand",
    "style": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chibat/chrome-extension-typescript-starter.git"
  },
  "dependencies": {
    "@types/react-transition-group": "^4.4.1",
    "archiver": "^7.0.1",
    "clsx": "1.2.1",
    "fs-extra": "^11.2.0",
    "mixpanel-browser": "^2.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/chrome": "^0.0.100",
    "@types/jest": "^25.1.4",
    "@types/jquery": "^3.3.33",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^7.1.4",
    "dotenv-webpack": "^8.1.0",
    "glob": "^7.1.6",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^2.2.1",
    "react-switch": "^7.0.0",
    "rimraf": "^3.0.2",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^6.2.1",
    "typescript": "^5.6.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^4.0.0",
    "webpack-merge": "~4.2.2"
  }
}
